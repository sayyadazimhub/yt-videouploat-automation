{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "src/index.js": {
      "includeFiles": "node_modules/@ffmpeg-installer/**,node_modules/@ffprobe-installer/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ]
}
